---
import Base from '../../layouts/Base.astro';
import { site } from '../../lib/data';
---

<Base title="Join F3 Lawrence" description="Request an invite to the F3 Lawrence Slack and come post with us. Free, peer-led workouts for men in Lawrence, KS.">
  <section class="max-w-2xl">
    <header class="mb-8 border-b border-rule pb-6">
      <p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">Join us</p>
      <h1 class="font-display text-5xl sm:text-6xl leading-none tracking-tight text-ink">JOIN F3 LAWRENCE</h1>
      <p class="mt-3 font-heading text-lg text-muted">
        The fastest way in is to just show up. See the
        <a href="/locations/" class="text-accent-link underline">locations</a>.
        Want a heads-up first, or an invite to our Slack? Drop a note below and
        <strong class="text-ink">Big Toe</strong> will reach out and get you connected.
      </p>
    </header>

    <form id="contact-form" method="post" action="/api/contact" class="space-y-5">
      <div>
        <label for="contact-name" class="font-mono text-xs uppercase text-muted block mb-1">Your name</label>
        <input id="contact-name" type="text" name="name" required maxlength="80" class="w-full border border-rule bg-surface px-3 py-2 font-mono" />
      </div>
      <div>
        <label for="contact-reach" class="font-mono text-xs uppercase text-muted block mb-1">How should we reach you? <span class="text-muted">(Slack, email, or phone)</span></label>
        <input id="contact-reach" type="text" name="reach" maxlength="200" class="w-full border border-rule bg-surface px-3 py-2 font-mono" />
      </div>
      <div>
        <label for="contact-ao" class="font-mono text-xs uppercase text-muted block mb-1">Which AO are you eyeing?</label>
        <select id="contact-ao" name="ao" class="w-full border border-rule bg-surface px-3 py-2 font-mono">
          <option value="">No preference</option>
          {site.aos.map((a) => <option value={a.name}>{a.name}</option>)}
        </select>
      </div>
      <div>
        <label for="contact-message" class="font-mono text-xs uppercase text-muted block mb-1">Anything else? <span class="text-muted">(optional)</span></label>
        <textarea id="contact-message" name="message" rows="3" maxlength="1000" class="w-full border border-rule bg-surface px-3 py-2 font-mono"></textarea>
      </div>

      {/* Spam trap: must stay empty; hidden from people. */}
      <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">
        <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name="loaded_at" />

      <div id="turnstile-widget" class="min-h-16"></div>
      <div id="turnstile-status" aria-live="polite" class="font-mono text-sm text-muted">
        Loading verification …
      </div>

      <button id="contact-submit" type="submit" disabled aria-describedby="turnstile-status"
              class="bg-accent-red text-surface font-heading font-semibold uppercase tracking-wide px-6 py-3 hover:bg-accent-red-bright disabled:cursor-not-allowed disabled:opacity-50">
        Send it
      </button>

      <div id="form-status" aria-live="polite" class="font-mono text-sm"></div>
    </form>

    <p class="mt-8 font-mono text-xs text-muted">
      No spam, no list. This goes straight to our leadership. That's it.
    </p>
  </section>
</Base>

<script>
  import {
    createContactFormController,
    selectTurnstileSiteKey,
    type ContactFormStatus,
  } from '../../lib/contact-form-controller';

  type TurnstileApi = {
    render: (
      container: HTMLElement,
      options: {
        sitekey: string;
        action: string;
        callback: (token: string) => void;
        'expired-callback': () => void;
        'error-callback': () => void;
      },
    ) => string;
    reset: (widgetId: string) => void;
  };

  declare global {
    interface Window {
      turnstile?: TurnstileApi;
    }
  }

  const PRODUCTION_TURNSTILE_SITE_KEY = '0x4AAAAAAFFQOtzOy0HjVVtg';
  const TEST_TURNSTILE_SITE_KEY = '1x00000000000000000000AA';

  function setStatus(element: HTMLElement, status: ContactFormStatus) {
    element.textContent = status.message;
    const color = status.kind === 'success'
      ? 'text-accent-open font-semibold'
      : status.kind === 'error'
        ? 'text-accent-red font-semibold'
        : 'text-muted';
    element.className = `font-mono text-sm ${color}`;
  }

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const widget = document.getElementById('turnstile-widget');
    const challengeStatus = document.getElementById('turnstile-status');
    const formStatus = document.getElementById('form-status');
    if (!form || !submit || !widget || !challengeStatus || !formStatus) return;

    const loadedAt = form.elements.namedItem('loaded_at') as HTMLInputElement;
    const refreshLoadedAt = () => {
      loadedAt.value = String(Date.now());
    };
    refreshLoadedAt();

    let widgetId: string | null = null;
    const controller = createContactFormController({
      makeFormData: () => new FormData(form),
      send: async (data) => {
        const response = await fetch('/api/contact', { method: 'POST', body: data });
        let payload: { ok?: boolean; error?: string } = {};
        try {
          payload = await response.json();
        } catch {
          // A non-JSON response is converted to a useful generic message below.
        }
        return {
          ok: response.ok && payload.ok === true,
          error: typeof payload.error === 'string'
            ? payload.error
            : 'Submission failed. Try again.',
        };
      },
      resetForm: () => form.reset(),
      refreshLoadedAt,
      resetWidget: () => {
        if (widgetId !== null && window.turnstile) window.turnstile.reset(widgetId);
      },
      setSubmitDisabled: (disabled) => {
        submit.disabled = disabled;
      },
      setFormStatus: (status) => setStatus(formStatus, status),
      setChallengeStatus: (status) => setStatus(challengeStatus, status),
    });

    const renderWidget = () => {
      if (widgetId !== null) return;
      if (!window.turnstile) {
        controller.scriptFailed();
        return;
      }

      const sitekey = selectTurnstileSiteKey(
        window.location.hostname,
        PRODUCTION_TURNSTILE_SITE_KEY,
        TEST_TURNSTILE_SITE_KEY,
      );
      try {
        widgetId = window.turnstile.render(widget, {
          sitekey,
          action: 'join_f3',
          callback: (token) => controller.challengeReady(token),
          'expired-callback': () => controller.challengeExpired(),
          'error-callback': () => controller.challengeError(),
        });
      } catch {
        controller.scriptFailed();
      }
    };

    const existingScript = document.getElementById('turnstile-api') as HTMLScriptElement | null;
    if (existingScript) {
      if (window.turnstile) renderWidget();
      else existingScript.addEventListener('load', renderWidget, { once: true });
    } else {
      const script = document.createElement('script');
      script.id = 'turnstile-api';
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.defer = true;
      script.addEventListener('load', renderWidget, { once: true });
      script.addEventListener('error', () => controller.scriptFailed(), { once: true });
      document.head.appendChild(script);
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void controller.submit();
    });
  }

  initContactForm();
</script>
