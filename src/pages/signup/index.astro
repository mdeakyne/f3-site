---
import Base from '../../layouts/Base.astro';
import { PUBLIC_AO_CATALOG, PAX_CATALOG } from '../../lib/q-catalog';
// Serialize only the fields the browser needs. Slack configuration stays server-side.
const publicData = JSON.stringify({ pax: PAX_CATALOG.map(({ slug, name, latest }) => ({ slug, name, latest })) }).replace(/</g, '\\u003c');
const fieldClass = 'w-full border border-rule bg-surface px-3 py-2 font-mono';
const labelClass = 'font-mono text-xs uppercase text-muted block mb-1';
---

<Base title="Sign up to Q · F3 Lawrence">
  <header class="mb-8 border-b border-rule pb-6">
    <p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">Lead the way</p>
    <h1 class="font-display text-5xl sm:text-6xl leading-none tracking-tight text-ink">SIGN UP TO Q</h1>
    <p class="mt-3 font-heading text-lg text-muted">Claim a workout from tomorrow through the next two months. Earlier claims get a signup note in the AO’s Slack; on the day before, we post only the full pre-blast at 10 AM Central or immediately after that time. Changes or cancellations? Coordinate in Slack.</p>
  </header>
  <section class="max-w-2xl mb-12" aria-labelledby="claim-heading">
    <h2 id="claim-heading" class="font-heading text-2xl font-semibold mb-5">Claim your workout</h2>
    <noscript><p>JavaScript is required to confirm availability and complete verification.</p></noscript>
    <form id="q-form" method="post" action="/api/q-signup" class="space-y-5">
      <div><label for="q-ao" class={labelClass}>AO</label><select name="ao_slug" id="q-ao" required class={fieldClass}><option value="">Choose an AO</option>{PUBLIC_AO_CATALOG.map(({slug,name}) => <option value={slug}>{name}</option>)}</select></div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div><label for="q-date" class={labelClass}>Workout date</label><select name="event_date" id="q-date" required disabled class={fieldClass}><option value="">Checking availability …</option></select></div>
        <div><label for="q-time" class={labelClass}>Workout time (Central)</label><input name="time" id="q-time" readonly class={fieldClass} /></div>
      </div>
      <div class="relative">
        <label for="q-search" class={labelClass}>Q — search your F3 name</label>
        <input id="q-search" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="q-options" autocomplete="off" required class={fieldClass} aria-describedby="q-search-help" />
        <p id="q-search-help" class="mt-1 font-mono text-xs text-muted">PAX who posted or Q’d in the last three months. Use arrow keys and Enter to select, or choose Other / not listed.</p>
        <ul id="q-options" role="listbox" aria-label="F3 names" hidden class="absolute z-10 w-full max-h-60 overflow-auto border border-rule bg-surface shadow-lg"></ul>
        <input type="hidden" name="q_slug" />
        <label for="q-other" class="sr-only">Other F3 name</label>
        <input name="f3_name_other" id="q-other" type="text" maxlength="80" hidden placeholder="Type your F3 name" class={`${fieldClass} mt-2`} />
      </div>
      <div><label for="q-title" class={labelClass}>Pre-blast title</label><input name="title" id="q-title" required maxlength="120" class={fieldClass} /></div>
      <div><label for="q-description" class={labelClass}>Pre-blast description</label><textarea name="description" id="q-description" required maxlength="4000" rows="5" class={fieldClass}></textarea><p class="mt-1 font-mono text-xs text-muted">Tell the PAX what to expect. Emoji and Slack :emoji_codes: welcome.</p></div>
      <div><label for="q-coupon" class={labelClass}>Bring a coupon?</label><select name="coupon" id="q-coupon" required class={fieldClass}><option value="">Choose Yes or No</option><option value="yes">Yes</option><option value="no">No</option></select></div>
      <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden"><label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>
      <input type="hidden" name="loaded_at" /><input type="hidden" name="cf-turnstile-response" />
      <div id="turnstile-widget" class="min-h-16"></div>
      <div id="turnstile-status" aria-live="polite" class="font-mono text-sm text-muted">Loading verification …</div>
      <button id="q-submit" type="submit" disabled aria-describedby="turnstile-status availability-status" class="bg-accent-red text-surface font-heading font-semibold uppercase tracking-wide px-6 py-3 hover:bg-accent-red-bright disabled:cursor-not-allowed disabled:opacity-50">Claim workout</button>
      <div id="form-status" aria-live="polite" class="font-mono text-sm"></div>
      <a id="q-checklist" hidden href="/q-checklist/" class="bg-accent-red text-surface font-heading font-semibold uppercase tracking-wide px-6 py-3">Open your Q Checklist</a>
    </form>
  </section>
  <section aria-labelledby="upcoming-heading">
    <h2 id="upcoming-heading" class="font-heading text-2xl font-semibold mb-3">Upcoming workouts</h2>
    <p id="availability-status" role="status" class="font-mono text-sm text-muted mb-4">Checking availability …</p>
    <ul id="q-calendar" class="divide-y divide-rule border-y border-rule"></ul>
  </section>
  <script type="application/json" id="q-data" set:html={publicData}></script>
</Base>
<script>
  import { initQForm } from '../../lib/q-form-controller';
  initQForm(document, fetch, new Date());
</script>
