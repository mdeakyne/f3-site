---
import Base from '../../layouts/Base.astro';
---

<Base title="Q Calendar · F3 Lawrence">
  <header class="mb-8 border-b border-rule pb-6">
    <p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">Schedule</p>
    <h1 class="font-display text-5xl sm:text-6xl leading-none tracking-tight text-ink">Q CALENDAR</h1>
    <p class="mt-3 font-heading text-lg text-muted">Upcoming workouts from tomorrow through the next two months. All times are Central. Choose an open workout to lead.</p>
  </header>
  <p id="availability-status" role="status" class="font-mono text-sm text-muted mb-4">Checking availability …</p>
  <noscript><p>JavaScript is required to confirm current workout availability.</p></noscript>
  <ul id="q-calendar" class="divide-y divide-rule border-y border-rule"></ul>
</Base>
<script>
  import { initQCalendar } from '../../lib/q-calendar-controller';
  initQCalendar(document, fetch, new Date());
</script>
